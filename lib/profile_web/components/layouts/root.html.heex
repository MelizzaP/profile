<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>
      <%= assigns[:page_title] || "Melissa Patterson" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-blue-dark text-white m-4">
    <nav class="relative z-10">
      <div class="flex h-16 items-center justify-end gap-6 px-2 text-blue-light">
        <a href={~p"/about"} class="text-base font-medium hover:text-biege-light">About</a>
        <a href={~p"/experience"} class="text-base font-medium hover:text-biege-light">Experience</a>
      </div>
    </nav>
    <%= @inner_content %>
  </body>
</html>
